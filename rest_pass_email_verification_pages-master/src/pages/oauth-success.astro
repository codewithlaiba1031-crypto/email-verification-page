---
import "../styles/global.css";
export const prerender = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>Signed In - Chatbot</title>
  </head>
  <body
    class="min-h-screen bg-[#fcfcfc] flex items-center justify-center p-6 font-sans"
  >
    <div
      class="w-full max-w-[440px] bg-white rounded-4xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-8 sm:p-10 text-center"
    >
      <div
        class="mb-6 h-16 w-16 rounded-full bg-green-100 flex items-center justify-center mx-auto text-green-600"
      >
        <svg
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>

      <h1
        class="text-2xl sm:text-3xl font-bold text-[#1a1a1a] mb-3 tracking-tight"
      >
        Signed in successfully
      </h1>

      <p class="text-[#666] text-[15px] leading-relaxed">
        Taking you back to Chatbot...
      </p>
    </div>

    <script>
      const callbackUrl = new URL(
        "appwrite-callback-6a391bc3001d892628cb://oauth-success"
      );
      callbackUrl.search = window.location.search;
      callbackUrl.hash = window.location.hash;

      setTimeout(() => {
        window.location.href = callbackUrl.toString();
      }, 1800);
    </script>
  </body>
</html>
